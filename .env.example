# MSSQL
MSSQL_SA_PASSWORD=YourStrong!Password123

# Backend connection strings (use the MSSQL container above)
MASTER_DB_CONNECTION=Server=mssql;Database=SiteYonetimi_Master;User Id=sa;Password=YourStrong!Password123;TrustServerCertificate=True
SHARED_DB_CONNECTION=Server=mssql;Database=SiteYonetimi_Shared;User Id=sa;Password=YourStrong!Password123;TrustServerCertificate=True

# JWT
JWT_SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_SECRET_KEY_AT_LEAST_32_CHARS

# SendGrid
SENDGRID_API_KEY=SG.your_api_key_here

# URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5241
